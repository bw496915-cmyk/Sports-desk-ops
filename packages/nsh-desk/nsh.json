{
  "name": "Sportsdesk Desk",
  "id": "ops.sportsdesk.desk",
  "version": "0.2.0",
  "build": 2,
  "minRuntime": "0.4.0",
  "theme": "theme.json",
  "appearance": "system",
  "statusBar": {
    "foreground": "auto"
  },
  "capabilities": {
    "network": {
      "http": [
        {
          "host": "127.0.0.1",
          "methods": ["GET", "HEAD", "POST"],
          "schemes": ["http"]
        },
        {
          "host": "localhost",
          "methods": ["GET", "HEAD", "POST"],
          "schemes": ["http"]
        }
      ]
    },
    "process": {
      "env": ["SPORTSDESK_ORIGIN", "SPORTSDESK_ADMIN_TOKEN"]
    },
    "clipboard": true,
    "statusBar": true
  }
}
