{
  "name": "sportsdesk-ops",
  "version": "1.0.0",
  "private": true,
  "description": "SportsDesk ops CLI & workspace package (`bun x sportsdesk`, `bun x dx`, `bun x nsh-desk`, `bun x wrangler`)",
  "type": "module",
  "bin": {
    "sportsdesk": "./bin/sportsdesk.ts",
    "dx": "./bin/dx",
    "wrangler": "./bin/wrangler",
    "nsh-desk": "./bin/nsh-desk.ts",
    "sportsdesk-ticket": "./bin/sportsdesk-ticket.ts",
    "sportsdesk-flags": "./bin/sportsdesk-flags.ts",
    "sportsdesk-bet-flags": "./bin/sportsdesk-bet-flags.ts",
    "sportsdesk-layoff-risk": "./bin/sportsdesk-layoff-risk.ts",
    "sportsdesk-hierarchy-ingest": "./bin/sportsdesk-hierarchy-ingest.ts",
    "sportsdesk-schema": "./bin/sportsdesk-schema.ts",
    "sportsdesk-replay": "./bin/sportsdesk-replay.ts",
    "sportsdesk-catalog": "./bin/sportsdesk-catalog.ts",
    "sportsdesk-candidate": "./bin/sportsdesk-candidate.ts",
    "sportsdesk-settlement": "./bin/sportsdesk-settlement.ts",
    "sportsdesk-combo": "./bin/sportsdesk-combo.ts",
    "sportsdesk-fraud": "./bin/sportsdesk-fraud.ts",
    "sportsdesk-autobet": "./bin/sportsdesk-autobet.ts",
    "image-meta": "./bin/image-meta.ts",
    "blob-formdata": "./bin/blob-formdata.ts",
    "xml-parse": "./bin/xml-parse.ts",
    "bun-surface": "./bin/bun-surface.ts",
    "sql-query": "./bin/sql-query.ts",
    "desk-provenance": "./bin/desk-provenance.ts"
  },
  "scripts": {
    "sportsdesk": "bun ./bin/sportsdesk.ts",
    "dx": "./bin/dx",
    "wrangler": "./bin/wrangler",
    "nsh": "bun ./bin/nsh-desk.ts",
    "ticket": "bun ./bin/sportsdesk-ticket.ts",
    "flags": "bun ./bin/sportsdesk-flags.ts",
    "bet:flags": "bun ./bin/sportsdesk-bet-flags.ts",
    "layoff:risk": "bun ./bin/sportsdesk-layoff-risk.ts",
    "manager:ingest-hierarchy": "bun ./bin/sportsdesk-hierarchy-ingest.ts",
    "replay": "bun ./bin/sportsdesk-replay.ts",
    "catalog": "bun ./bin/sportsdesk-catalog.ts",
    "candidate": "bun ./bin/sportsdesk-candidate.ts",
    "settlement": "bun ./bin/sportsdesk-settlement.ts",
    "combo": "bun ./bin/sportsdesk-combo.ts",
    "fraud": "bun ./bin/sportsdesk-fraud.ts",
    "autobet": "bun ./bin/sportsdesk-autobet.ts",
    "image:meta": "bun ./bin/image-meta.ts",
    "blob:formdata": "bun ./bin/blob-formdata.ts",
    "xml:parse": "bun ./bin/xml-parse.ts",
    "bun:surface": "bun ./bin/bun-surface.ts",
    "sql:query": "bun ./bin/sql-query.ts",
    "desk:provenance": "bun ./bin/desk-provenance.ts",
    "cli:bins": "bun run --cwd ../.. cli:bins",
    "test": "bun run --cwd ../.. test",
    "typecheck": "bun run --cwd ../.. typecheck",
    "schema": "bun run --cwd ../.. schema",
    "schema:list": "bun run --cwd ../.. schema:list",
    "schema:json": "bun run --cwd ../.. schema:json"
  },
  "engines": {
    "bun": "1.4.4"
  }
}
