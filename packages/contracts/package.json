{
  "name": "@sportsdesk-ops/contracts",
  "version": "0.1.0",
  "description": "Shared SportsDesk contracts: wager tokens, slice metrics/registry, shadow pricing, feature flags, dashboard hydration.",
  "license": "MIT",
  "author": "SportsDesk Engineering",
  "homepage": "https://github.com/bw496915-cmyk/Sports-desk-ops/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/bw496915-cmyk/Sports-desk-ops/issues"
  },
  "keywords": [
    "sportsdesk",
    "contracts",
    "wager",
    "types",
    "bun"
  ],
  "engines": {
    "bun": ">=1.4.5",
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bw496915-cmyk/Sports-desk-ops.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./wager-tokens": {
      "types": "./src/wager_tokens.ts",
      "bun": "./src/wager_tokens.ts",
      "default": "./dist/wager_tokens.js"
    },
    "./slice-metrics": {
      "types": "./src/slice_metrics.ts",
      "bun": "./src/slice_metrics.ts",
      "default": "./dist/slice_metrics.js"
    },
    "./slice-registry": {
      "types": "./src/slice_registry.ts",
      "bun": "./src/slice_registry.ts",
      "default": "./dist/slice_registry.js"
    },
    "./slice-data-table": {
      "types": "./src/slice_data_table.ts",
      "bun": "./src/slice_data_table.ts",
      "default": "./dist/slice_data_table.js"
    },
    "./slice-diff-view": {
      "types": "./src/slice_diff_view.ts",
      "bun": "./src/slice_diff_view.ts",
      "default": "./dist/slice_diff_view.js"
    },
    "./shadow-pricing": {
      "types": "./src/shadow_pricing.ts",
      "bun": "./src/shadow_pricing.ts",
      "default": "./dist/shadow_pricing.js"
    },
    "./features": {
      "types": "./src/features.ts",
      "bun": "./src/features.ts",
      "default": "./dist/features.js"
    },
    "./dashboard-hydration": {
      "types": "./src/dashboard_hydration.ts",
      "bun": "./src/dashboard_hydration.ts",
      "default": "./dist/dashboard_hydration.js"
    },
    "./weblog-detectors": {
      "types": "./src/weblog_detectors.ts",
      "bun": "./src/weblog_detectors.ts",
      "default": "./dist/weblog_detectors.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "dist"
  ],
  "scripts": {
    "typecheck": "bun check --no-script -p tsconfig.json",
    "lint": "bun run --cwd ../.. lint:canary -- packages/contracts/src",
    "test": "bun test --no-script --cwd ../.. tests/slice_metrics.test.ts tests/wager_tiers_toml.test.ts tests/dashboard_ui_hydration.test.tsx tests/workspace_packs.test.ts tests/contracts_channel_ssot.test.ts tests/contracts_package_boundary.test.ts tests/wager_channels.test.ts",
    "sync:tokens": "bun scripts/sync_tokens.ts",
    "check:pack": "bun scripts/check_pack.ts",
    "build": "bun scripts/build.ts",
    "prepack": "bun run sync:tokens && bun run build"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:"
  }
}
