# Fantasy402 Portal Gateway
F402_BASE_URL=https://fantasy402.com
F402_AGENT_ID=BILLY666
F402_PASSWORD=your_portal_password
F402_OFFLINE_ONLY=0
F402_INITIAL_WATERMARK=0

# Webview & API Server
PORT=4020
NODE_ENV=production

# Network & Proxy Isolation (Prevents proxy trapping of local loopback calls)
NO_PROXY=127.0.0.1,localhost,::1
BUN_CONFIG_MAX_HTTP_REQUESTS=256

# Cloudflare R2 Storage & API
CLOUDFLARE_ACCOUNT_ID=7a470541a704caaf91e71efccc78fd36
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://7a470541a704caaf91e71efccc78fd36.r2.cloudflarestorage.com
R2_BUCKET_NAME=sportsdesk-ops-reports
R2_PUBLIC_URL=https://pub-d061f943df0e4477ba7ff200721eddb1.r2.dev

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=demodevdeskbot
# Default chat for alerts and reports; send /chatid to the bot to find it. Without it the bot only simulates sends.
TELEGRAM_CHAT_ID=
# Extra chats (comma-separated) allowed to use bot commands besides TELEGRAM_CHAT_ID
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_MINIAPP_URL=https://desk.bookdeskops.com/miniapp
TELEGRAM_WEBHOOK_URL=https://desk.bookdeskops.com/telegram/webhook
# Required before the dashboard can register the webhook; Telegram echoes it back on every update
TELEGRAM_WEBHOOK_SECRET=
# Bearer token for the dashboard's Telegram controls and /api/* (unset = those endpoints return 503)
SPORTSDESK_ADMIN_TOKEN=
# Sent/received message log shown in the dashboard (default reports/telegram-activity.jsonl, gitignored)
TELEGRAM_ACTIVITY_LOG=
TELEGRAM_ALERT_THRESHOLD_CENTS=500000
TELEGRAM_REPORT_SCHEDULE="0 8,13,23 * * *"

# Polymarket combo uniqueness (dx combo uniqueness). CLI flags win over these.
CACHE_TTL_HOURS=24
# CACHE_DIR=scratch/cfb-combo-cache
# FRESH=1
# SEED_TRADES=1
# STRICT_FULL_GAME=1
# ALL_LEGS_CFB=1
# INCLUDE_CLOSED_GAMES=1
# CONCURRENCY=6
# LEADERBOARD=0
# LEADERBOARD_LIMIT=100
# MAX_SEED_MARKETS=60
# WALLET_FILE=wallets.txt

# Cross-domain bridge (dx bridge value --live). CLI flags win over these.
BRIDGE_TTL_HOURS=24
