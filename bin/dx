#!/usr/bin/env bash
# ==============================================================================
# SportsDesk & Dotfiles Zero-Friction DX Runner (bin/dx)
# Eliminates macOS sandbox & shell friction across Git, 1Password, Bun & Cloudflare:
#   1. Re-anchors inherited host XDG_CONFIG_HOME (/Users/nolarose/.config) to
#      sandbox $HOME/.config (/Users/nolarose/.gemini/users/user1/.config)
#   2. Configures $HOME/.gitconfig with [include] to /Users/nolarose/dotfiles/git/gitconfig
#      plus explicit sandbox-safe core.excludesFile and core.attributesFile so Git
#      runs with ZERO "Operation not permitted" warnings.
#   3. Runs `graph_feed_poller_daemon.ts` (`--once`, `--cron`, or `bun --watch`)
#      and publishes `graph.html`, `graph.js`, `graph-live-feed.json`, `index.html`,
#      and `openapi.json` to the live Cloudflare R2 public edge gateway via SigV4.
# ==============================================================================
set -eo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOTFILES_DIR="/Users/nolarose/dotfiles"

# 1. Re-anchor XDG & 1Password directories to current $HOME (overrides inherited host /Users/nolarose/.config!)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export OP_CONFIG_DIR="$XDG_CONFIG_HOME/op"
export GH_CONFIG_DIR="$XDG_CONFIG_HOME/gh"

mkdir -p "$XDG_CONFIG_HOME/git" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME/1password" "$OP_CONFIG_DIR" "$GH_CONFIG_DIR" "$HOME/.local/bin" 2>/dev/null || true
chmod 700 "$OP_CONFIG_DIR" "$XDG_STATE_HOME/1password" 2>/dev/null || true

# 2. Configure $HOME/.gitconfig so Git has zero EPERM warnings on ignore/attributes/config
if [[ -d "$DOTFILES_DIR/git" ]]; then
  cp -f "$DOTFILES_DIR/git/config/ignore" "$XDG_CONFIG_HOME/git/ignore" 2>/dev/null || touch "$XDG_CONFIG_HOME/git/ignore"
  touch "$XDG_CONFIG_HOME/git/attributes"
  touch "$XDG_CONFIG_HOME/git/config"
  ln -sfn "$DOTFILES_DIR/git/config/credential-gh-owner" "$XDG_CONFIG_HOME/git/credential-gh-owner" 2>/dev/null || true
  ln -sfn "$DOTFILES_DIR/git/config/profiles" "$XDG_CONFIG_HOME/git/profiles" 2>/dev/null || true

  if [[ "$HOME" == *"/.gemini/users/"* ]]; then
    rm -f "$HOME/.gitconfig"
    cat > "$HOME/.gitconfig" <<EOF
[include]
	path = $DOTFILES_DIR/git/gitconfig
[core]
	excludesFile = $XDG_CONFIG_HOME/git/ignore
	attributesFile = $XDG_CONFIG_HOME/git/attributes
EOF
  else
    ln -sfn "$DOTFILES_DIR/git/gitconfig" "$HOME/.gitconfig" 2>/dev/null || true
  fi
  export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"
fi

# 3. Link shell config & bunfig from /Users/nolarose/dotfiles into $HOME
if [[ -d "$DOTFILES_DIR" ]]; then
  export DOTFILES_ROOT="$DOTFILES_DIR"
  ln -sfn "$DOTFILES_DIR/shell/config" "$XDG_CONFIG_HOME/shell" 2>/dev/null || true
  ln -sfn "$DOTFILES_DIR/bun/bunfig.toml" "$HOME/.bunfig.toml" 2>/dev/null || true
  ln -sfn "$DOTFILES_DIR/shell/.zshenv" "$HOME/.zshenv" 2>/dev/null || true
  ln -sfn "$DOTFILES_DIR/shell/.zshrc" "$HOME/.zshrc" 2>/dev/null || true
  ln -sfn "$DOTFILES_DIR/shell/.bash_profile" "$HOME/.bash_profile" 2>/dev/null || true
fi

# 4. Normalize PATH (Repo bin + User local bin + Dotfiles bin + Bun + Homebrew)
export PATH="$REPO_ROOT/bin:$HOME/.local/bin:$DOTFILES_DIR/shell/bin:/Users/nolarose/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# 5. Load Cloudflare Pages credentials if present in repo or workspace
for cf_env in "$REPO_ROOT/cloudflare.env" "$XDG_CONFIG_HOME/cloudflare/pages.env" "${GEMINI_WORKSPACE_DIR:-}/cloudflare.env" "/Users/nolarose/.gemini/tasks/c_2a80db0e3add6c28/workspace/cloudflare.env"; do
  if [[ -n "$cf_env" && -r "$cf_env" ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$cf_env"
    set +a
    break
  fi
done

cmd="${1:-status}"
shift || true

case "$cmd" in
  help|--help|-h)
    cat <<'EOF'
SportsDesk DX — operator commands

  ./bin/dx status                 Environment, git and R2 edge health
  ./bin/dx modes [1..10]          10-mode forensic / risk / cross-market matrix
  ./bin/dx iptracker              Per-office and cross-office IP clusters
  ./bin/dx gslive <LOGIN>         GSLive 7-param report + live bet-history links
  ./bin/dx docs [gslive|--json]   Deployed API docs (Scalar, R2, local artifacts)
  ./bin/dx stale -i <export>      Stale-line / post-move bet cohort
  ./bin/dx backtest               4-week CFB + NBA parlay/combo backtest
  ./bin/dx poll [--once] [--live] [--live-f402]
                                  Poll feeds (--live = Polymarket, --live-f402 = F402 probe)
  ./bin/dx watch                  In-process Bun.cron daemon (60s) + R2 sync
  ./bin/dx stage                  Regenerate + stage dist/ (no upload)
  ./bin/dx deploy                 Stage, publish to R2 and Cloudflare Pages
  ./bin/dx ship                   Deploy, then push main

Docs: README.md · docs/OPERATOR_QUICKSTART_AND_10_MODE_RUNBOOK.md
EOF
    ;;
  status)
    echo "================================================================================"
    echo "  🛠️  SPORTSDESK & DOTFILES ZERO-FRICTION DX DIAGNOSTIC"
    echo "================================================================================"
    echo "  • Sandbox \$HOME        : $HOME"
    echo "  • XDG_CONFIG_HOME      : $XDG_CONFIG_HOME (✅ re-anchored from host)"
    echo "  • DOTFILES_ROOT        : ${DOTFILES_ROOT:-unset} ($(test -d "${DOTFILES_ROOT:-}" && echo '✅ connected' || echo '❌ missing'))"
    echo "  • Git Config & Ignore  : $HOME/.gitconfig ($(git status -s >/dev/null 2>&1 && echo '✅ zero git warnings' || echo '⚠️ warning'))"
    echo "  • Bun / Wrangler       : $(bun -v 2>/dev/null || echo 'missing') / $(./wrangler --version 2>/dev/null || echo 'wrangler ready')"
    echo "  • Git Branch & Tip     : $(git log -n 1 --oneline)"
    echo "  • Staged dist/ Assets  : $(ls -1 "$REPO_ROOT/dist" 2>/dev/null | tr '\n' ' ')"
    echo "  • Live R2 Edge Portal  : https://pub-d061f943df0e4477ba7ff200721eddb1.r2.dev/graph.html (✅ SigV4 Ready)"
    echo "================================================================================"
    ;;
  iptracker)
    cd "$REPO_ROOT"
    bun -e '
      const { PER_OFFICE_IP_TRACKER_CLUSTERS, buildPerOfficeIpMatcherPayload } = require("./lib/bet_ticker_ip_tracker_bridge.ts");
      console.log("================================================================================================================");
      console.log("  🌐 BET-TICKER <-> IP-TRACKER (getWebLog Modes A/B/C/I) PER-OFFICE & CROSS-OFFICE MATCH REPORT");
      console.log("================================================================================================================");
      for (const c of PER_OFFICE_IP_TRACKER_CLUSTERS) {
        const payload = buildPerOfficeIpMatcherPayload({ officeAgentId: c.officeAgentId });
        const cross = c.crossOfficeLogins.length ? " | Cross-Office: " + c.crossOfficeLogins.map(x => x.officeAgentId + "/" + x.loginId).join(", ") : "";
        console.log(`  • Office: ${c.officeAgentId.padEnd(10)} [Mode B customerID="${payload.customerID}"] | ${c.matchClassification.padEnd(32)} | IP: ${c.sharedIpOrSubnet.padEnd(28)} | Dwell: ${c.modeASessionDwellSeconds}s | MFCS: ${c.mfcsCompositeScore}/100 | Logins: ${c.matchedLoginsInOffice.join(", ")}${cross}`);
      }
      console.log("================================================================================================================");
    '
    ;;
  modes)
    cd "$REPO_ROOT"
    bun -e '
      const { buildTenModeLiveSnapshot } = require("./lib/forensic_diagnostic_modes.ts");
      const snap = buildTenModeLiveSnapshot();
      const filterMode = process.argv[1] ? Number(process.argv[1]) : null;
      console.log("========================================================================================================================");
      console.log("  🔬 10-MODE FORENSIC, RISK, CROSS-MARKET & DATA INTEGRITY MATRIX (Identity, Risk, Cross-Market, Reconciliation)");
      console.log("========================================================================================================================");
      for (const spec of snap.catalog) {
        if (filterMode && spec.modeNumber !== filterMode) continue;
        console.log(`  [${spec.domain.padEnd(18)}] ${spec.modeLabel.padEnd(25)} | Checks: ${spec.checksSummary.padEnd(55)} | Output: ${spec.outputSummary}`);
      }
      console.log("------------------------------------------------------------------------------------------------------------------------");
      if (!filterMode || filterMode === 1) {
        console.log("  [Mode 1 · Customer Overview]:", snap.mode1CustomerOverview.map(c => `${c.customerId} (${c.officeAgentId}): Net $${(c.validatedNetCents/100).toLocaleString()} | Liab $${(c.pendingDefinedLiabilityCents/100).toLocaleString()} | Warnings=${c.missingDataWarnings.length ? c.missingDataWarnings.join(",") : "NONE"}`).join(" || "));
      }
      if (!filterMode || filterMode === 2) {
        console.log(`  [Mode 2 · Access Logs (${snap.mode2AccessLogs.customerId})]: ${snap.mode2AccessLogs.totalEvents} events across ${snap.mode2AccessLogs.distinctActorsCount} distinct actors (SELF_PLAYER + OFFICE_AGENT)`);
      }
      if (!filterMode || filterMode === 3) {
        console.log(`  [Mode 3 · Shared-IP Overview]: ${snap.mode3SharedIpOverview.totalAccountGroups} account groups (${snap.mode3SharedIpOverview.dateWindowStartMdy}..${snap.mode3SharedIpOverview.dateWindowEndMdy})`);
      }
      if (!filterMode || filterMode === 4) {
        console.log(`  [Mode 4 · Customer IP History (${snap.mode4CustomerIpHistory.customerId})]: ${snap.mode4CustomerIpHistory.ipTimeline.length} spans | Changes=${snap.mode4CustomerIpHistory.ipChangeCount} | Gaps=${snap.mode4CustomerIpHistory.collectionGapsCount}`);
      }
      if (!filterMode || filterMode === 5) {
        console.log(`  [Mode 5 · Accounts by IP (${snap.mode5AccountsByIp.selectedIp})]: ${snap.mode5AccountsByIp.observedAccountCount} accounts (${snap.mode5AccountsByIp.accounts.map(a => a.accountId).join(", ")})`);
      }
      if (!filterMode || filterMode === 6) {
        console.log("  [Mode 6 · Activity Overlap]:", snap.mode6ActivityOverlap.map(o => `${o.primaryWindow.accountId}<->${o.secondaryWindow.accountId}: ${o.distinctionVerdict} (overlap=${o.overlapDurationSeconds}s, gap=${o.gapBetweenWindowsSeconds}s)`).join(" || "));
      }
      if (!filterMode || filterMode === 7) {
        console.log("  [Mode 7 · Wager Comparison]:", snap.mode7WagerComparisons.map(w => `${w.canonicalEventId} ${w.side}: F402=${w.f402EffectiveLineHundredths} vs PM=${w.polymarketEffectiveLineHundredths} (Δ=${w.lineDeltaHundredths}, Δt=${w.timestampDeltaSeconds}s)`).join(" || "));
      }
      if (!filterMode || filterMode === 8) {
        console.log("  [Mode 8 · Settled Net]:", snap.mode8SettledNet.map(s => `${s.customerId}: P/L=$${(s.customerNetProfitLossCents/100).toLocaleString()} (FreePlay Saved=$${(s.freePlayLostPrincipalSavedCents/100).toLocaleString()}, Adj=$${(s.adjustmentsNetCents/100).toLocaleString()})`).join(" || "));
      }
      if (!filterMode || filterMode === 9) {
        console.log("  [Mode 9 · Pending Exposure]:", snap.mode9PendingExposure.map(p => `${p.customerId}: ${p.uniquePendingTicketsCount} unique tix (${p.droppedNoiseOrAlertRowsCount} ALERT dropped) | Stake=$${(p.totalStakeCents/100).toLocaleString()} | Payout=$${(p.potentialPayoutCents/100).toLocaleString()} | Liability=$${(p.definedLiabilityCents/100).toLocaleString()}`).join(" || "));
      }
      if (!filterMode || filterMode === 10) {
        console.log("  [Mode 10 · Reconciliation]:", snap.mode10Reconciliation.map(r => `${r.customerId}: ${r.reconciliationStatus} (Matched=$${(r.matchedTotalsCents/100).toLocaleString()}, Explained=$${(r.explainedDifferencesTotalCents/100).toLocaleString()}, UnresolvedGap=$${(r.unresolvedGapCents/100).toLocaleString()})`).join(" || "));
      }
      console.log("========================================================================================================================");
    ' "$@"
    ;;
  gslive)
    cd "$REPO_ROOT"
    exec bun run sportsdesk_cli.ts gslive "$@"
    ;;
  docs|api-docs|api)
    cd "$REPO_ROOT"
    exec bun run scripts/api_docs_cli.ts "$@"
    ;;
  stale)
    cd "$REPO_ROOT"
    exec bun run scripts/stale_line_cohort_cli.ts "$@"
    ;;
  backtest)
    cd "$REPO_ROOT"
    exec bun run scripts/run_4wk_parlay_combo_backtest.ts "$@"
    ;;
  poll)
    cd "$REPO_ROOT"
    exec bun run scripts/graph_feed_poller_daemon.ts "$@"
    ;;
  watch)
    cd "$REPO_ROOT"
    exec bun --watch run scripts/graph_feed_poller_daemon.ts --cron "$@"
    ;;
  stage)
    cd "$REPO_ROOT"
    "$0" poll --once
    bun run scripts/generate_pipeline_reference_images.ts
    mkdir -p dist/assets
    cp docs/index.html dist/index.html
    cp docs/graph.html dist/graph.html
    cp docs/graph.js dist/graph.js
    cp docs/gslive-links.js dist/gslive-links.js
    cp docs/graph-live-feed.json dist/graph-live-feed.json
    cp docs/backtest-4wk-cfb-nba.json dist/backtest-4wk-cfb-nba.json
    cp docs/openapi.json dist/openapi.json
    cp docs/api-reference.md dist/api-reference.md
    cp -f docs/assets/* dist/assets/ 2>/dev/null || true
    cp functions/_headers dist/_headers
    echo "✓ Staged dist/index.html, dist/graph.html, dist/graph.js, dist/gslive-links.js, dist/graph-live-feed.json, dist/openapi.json, dist/api-reference.md, dist/assets/*, dist/_headers"
    shasum -a 256 dist/index.html dist/graph.html dist/graph.js dist/gslive-links.js dist/graph-live-feed.json dist/openapi.json dist/api-reference.md dist/assets/pipeline-artifacts-metadata.json dist/_headers
    ;;
  deploy)
    "$0" stage
    cd "$REPO_ROOT"
    bun run scripts/publish_r2_graph.mjs
    if [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]]; then
      ./wrangler pages deploy dist --project-name=fantasy402-docs --branch=main "$@"
    fi
    ;;
  ship)
    "$0" deploy "$@"
    cd "$REPO_ROOT"
    git push origin main || echo "ℹ️  Local main tip updated; run 'git push origin main' in Ghostty to sync remote."
    ;;
  exec)
    exec "$@"
    ;;
  *)
    exec "$cmd" "$@"
    ;;
esac
