#!/usr/bin/env bash
# ==============================================================================
# SportsDesk & Dotfiles Zero-Friction DX Runner (bin/dx)
# Eliminates macOS sandbox & shell friction across Git, 1Password, Bun & Cloudflare:
#   1. Re-anchors an inherited host XDG_CONFIG_HOME to the current $HOME/.config
#      (inside the Gemini sandbox $HOME is <host home>/.gemini/users/<id>).
#   2. Links $HOME/.gitconfig, shell config and bunfig to the dotfiles checkout so Git
#      runs with ZERO "Operation not permitted" warnings. Linking is NON-DESTRUCTIVE:
#      a correct link is left alone, a stale symlink is repointed, and a real file or
#      directory is never replaced (see link_managed; `dx setup --replace` backs it up).
#   3. Runs `graph_feed_poller_daemon.ts` (`--once`, `--cron`, or `bun --watch`)
#      and publishes `graph.html`, `graph.js`, `graph-live-feed.json`, `index.html`,
#      and `openapi.json` to the live Cloudflare R2 public edge gateway via SigV4.
# ==============================================================================
set -eo pipefail

dx_resolve_script_dir() {
  local src="$1" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

REPO_ROOT="$(cd -P "$(dx_resolve_script_dir "${BASH_SOURCE[0]}")/.." && pwd)"

# Host home: inside the sandbox $HOME is <host home>/.gemini/users/<id>; elsewhere it is $HOME.
HOST_HOME="${HOME%%/.gemini/users/*}"
ORIG_XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-}"

# Dotfiles checkout: explicit override, then $HOME/dotfiles, then the host home's.
DOTFILES_DIR="${DX_DOTFILES_DIR:-${DOTFILES_ROOT:-}}"
if [[ -z "$DOTFILES_DIR" ]]; then
  for candidate in "$HOME/dotfiles" "$HOST_HOME/dotfiles"; do
    if [[ -d "$candidate" ]]; then
      DOTFILES_DIR="$candidate"
      break
    fi
  done
fi
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# `dx setup --replace` is the only way a real file/directory at a link destination is replaced
# (it is moved to <dest>.dx-backup-<epoch> first). Decided here, before any linking runs.
DX_SETUP_REPLACE=0
if [[ "${1:-}" == "setup" && " $* " == *" --replace "* ]]; then
  DX_SETUP_REPLACE=1
fi
DX_LINK_CONFLICTS=()

# link_managed <source> <dest>: make <dest> a symlink to <source> without destroying data.
#   - dest already links to source ........ nothing (no mtime churn)
#   - dest is another symlink ............. repointed (a pointer holds no data)
#   - dest is a real file or directory .... recorded as a conflict and left alone
#   - dest is missing ..................... created
link_managed() {
  local src="$1" dst="$2"
  [[ -e "$src" || -L "$src" ]] || return 0
  if [[ -L "$dst" ]]; then
    [[ "$(readlink "$dst")" == "$src" ]] && return 0
    ln -sfn "$src" "$dst" 2>/dev/null || true
  elif [[ -e "$dst" ]]; then
    if [[ "$DX_SETUP_REPLACE" == "1" ]]; then
      mv "$dst" "$dst.dx-backup-$(date +%s)" 2>/dev/null && ln -s "$src" "$dst" 2>/dev/null || true
    else
      DX_LINK_CONFLICTS+=("$dst")
    fi
  else
    ln -s "$src" "$dst" 2>/dev/null || true
  fi
}

# 1. Re-anchor XDG & 1Password directories to current $HOME (an inherited host value is overridden)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export OP_CONFIG_DIR="$XDG_CONFIG_HOME/op"
export GH_CONFIG_DIR="$XDG_CONFIG_HOME/gh"

mkdir -p "$XDG_CONFIG_HOME/git" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME/1password" "$OP_CONFIG_DIR" "$GH_CONFIG_DIR" "$HOME/.local/bin" "$HOME/.bun/bin" "$HOME/.grok/bin" "$HOME/.kimi-code/bin" "$HOME/.cursor" "$HOME/Projects" 2>/dev/null || true
chmod 700 "$OP_CONFIG_DIR" "$XDG_STATE_HOME/1password" 2>/dev/null || true

# 2. Configure $HOME/.gitconfig so Git has zero EPERM warnings on ignore/attributes/config
if [[ -d "$DOTFILES_DIR/git" ]]; then
  # `links.ts` may already point ~/.config/git at the dotfiles config directory. Linking or
  # copying a child into that path then writes the source onto itself, which is how
  # `credential-gh-owner -> credential-gh-owner` (and `profiles/profiles`) kept reappearing.
  if [[ "$(cd "$XDG_CONFIG_HOME/git" 2>/dev/null && pwd -P)" == "$(cd "$DOTFILES_DIR/git/config" && pwd -P)" ]]; then
    :
  else
    cp -f "$DOTFILES_DIR/git/config/ignore" "$XDG_CONFIG_HOME/git/ignore" 2>/dev/null || touch "$XDG_CONFIG_HOME/git/ignore"
    touch "$XDG_CONFIG_HOME/git/attributes"
    touch "$XDG_CONFIG_HOME/git/config"
    link_managed "$DOTFILES_DIR/git/config/credential-gh-owner" "$XDG_CONFIG_HOME/git/credential-gh-owner"
    link_managed "$DOTFILES_DIR/git/config/profiles" "$XDG_CONFIG_HOME/git/profiles"
  fi

  if [[ "$HOME" == *"/.gemini/users/"* ]]; then
    # Sandbox: ~/.gitconfig is a generated file (a symlink cannot carry the sandbox-safe
    # excludes). It is rewritten only when it is ours: absent, a symlink, byte-identical to the
    # generated body, or carrying the marker. Anything else is the user's and is left alone.
    dx_marker="# managed by bin/dx"
    dx_body="[include]
	path = $DOTFILES_DIR/git/gitconfig
[core]
	excludesFile = $XDG_CONFIG_HOME/git/ignore
	attributesFile = $XDG_CONFIG_HOME/git/attributes
[credential \"https://github.com\"]
	helper = 
	useHttpPath = true
	helper = $XDG_CONFIG_HOME/git/credential-gh-owner"
    dx_full="$dx_marker"$'\n'"$dx_body"
    dx_write=0
    if [[ -L "$HOME/.gitconfig" || ! -e "$HOME/.gitconfig" ]]; then
      dx_write=1
    else
      dx_current="$(cat "$HOME/.gitconfig" 2>/dev/null || true)"
      if [[ "$dx_current" == "$dx_full" ]]; then
        : # already current
      elif [[ "$dx_current" == "$dx_body" || "$dx_current" == "$dx_marker"$'\n'* ]]; then
        dx_write=1 # ours: the pre-marker generated body, or an older marked body
      elif [[ "$DX_SETUP_REPLACE" == "1" ]]; then
        cp "$HOME/.gitconfig" "$HOME/.gitconfig.dx-backup-$(date +%s)" && dx_write=1
      else
        DX_LINK_CONFLICTS+=("$HOME/.gitconfig")
      fi
    fi
    if [[ "$dx_write" == "1" ]]; then
      rm -f "$HOME/.gitconfig"
      printf '%s\n' "$dx_full" > "$HOME/.gitconfig"
    fi
  else
    link_managed "$DOTFILES_DIR/git/gitconfig" "$HOME/.gitconfig"
  fi
  export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"
fi

# 3. Link shell config, bunfig, root stubs, cursor permissions, and BIN_LINKS from dotfiles into $HOME
if [[ -d "$DOTFILES_DIR" ]]; then
  export DOTFILES_ROOT="$DOTFILES_DIR"
  link_managed "$DOTFILES_DIR/shell/config" "$XDG_CONFIG_HOME/shell"
  link_managed "$DOTFILES_DIR/bun/bunfig.toml" "$HOME/.bunfig.toml"
  link_managed "$DOTFILES_DIR/shell/.zshenv" "$HOME/.zshenv"
  link_managed "$DOTFILES_DIR/shell/.zprofile" "$HOME/.zprofile"
  link_managed "$DOTFILES_DIR/shell/.zshrc" "$HOME/.zshrc"
  link_managed "$DOTFILES_DIR/shell/.bash_profile" "$HOME/.bash_profile"
  link_managed "$DOTFILES_DIR/npm/npmrc" "$HOME/.npmrc"
  link_managed "$DOTFILES_DIR/ripgrep/rgignore" "$HOME/.rgignore"
  link_managed "$DOTFILES_DIR/ripgrep/ripgreprc" "$HOME/.ripgreprc"
  link_managed "$DOTFILES_DIR/cursor/permissions.json" "$HOME/.cursor/permissions.json"
  link_managed "$DOTFILES_DIR/cursor/rules" "$HOME/.cursor/rules"
  for dx_bin in shell-health root-health op-health op-agent-preflight code-1password-check finish-1password setup-1password code-1password-dashboard code-github-discover code-project code-dashboard code-dashboard-render gate gate-fast; do
    link_managed "$DOTFILES_DIR/shell/bin/$dx_bin" "$HOME/.local/bin/$dx_bin"
  done
  link_managed "$DOTFILES_DIR/bin/dsh" "$HOME/.local/bin/dsh"
  link_managed "$DOTFILES_DIR/bin/dsh" "$HOME/.bun/bin/dsh"
fi

# 4. Normalize PATH (Repo bin + User local bin + Dotfiles bin + Bun + Homebrew)
export PATH="$REPO_ROOT/bin:$HOME/.local/bin:$DOTFILES_DIR/shell/bin:$HOME/.bun/bin:$HOST_HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# 5. Load Cloudflare Pages credentials if present in repo or workspace.
# Only the two Pages names are read, as data: the file is never `source`d, so a stray `R2_*` /
# `F402_*` line or a command in it cannot reach every `dx` subcommand. A value already in the
# environment (keychain via `dx exec --with pages`, CI) wins over the file.
dx_load_pages_env() {
  local file="$1" line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line#export }"
    case "$line" in
      CLOUDFLARE_API_TOKEN=* | CLOUDFLARE_ACCOUNT_ID=*)
        key="${line%%=*}"
        value="${line#*=}"
        value="${value%[\"\']}"
        value="${value#[\"\']}"
        [[ -n "${!key:-}" ]] || export "$key=$value"
        ;;
    esac
  done <"$file"
}
for cf_env in "$REPO_ROOT/cloudflare.env" "$XDG_CONFIG_HOME/cloudflare/pages.env" "${GEMINI_WORKSPACE_DIR:-}/cloudflare.env"; do
  if [[ -n "$cf_env" && -r "$cf_env" ]]; then
    dx_load_pages_env "$cf_env"
    break
  fi
done

# Every command `dx` dispatches itself. Keep in step with the case below (`dx_commands_check`
# in tests/dx_cli.test.ts fails when they drift) and with `help`.
DX_COMMANDS="help status setup scripts run monitor live-bets iptracker modes gslive docs api-docs api stale profile combo bridge crossdomain shot session screenshot image-meta assets bun provenance deps blob-formdata xml-parse sql fetch-config fetch-i18n fetch-common fetch-live-data fetch-report-status fetch-report-periods wagers-by-state wagers-by-state-live ticket flags bet-flags layoff-risk queue backtest poll watch pipeline stage deploy ship exec enrich taxonomy edge shadow-price nsh worktrees workspaces"

# dx_bun_run <script_or_file> [args...]: fast `bun run` when DX_BUN_FLAGS is unset; otherwise
# delegates through `dx_run_control.ts` so every flag in DX_BUN_FLAGS is validated against live
# `bun run --help` and checked for BUN_CONFIG_VERBOSE_FETCH secret safety.
dx_bun_run() {
  if [[ -n "${DX_BUN_FLAGS:-}" ]]; then
    exec bun "$REPO_ROOT/scripts/dx_run_control.ts" run --no-containment -- "$@"
  fi
  if [[ -n "${BUN_CONFIG_VERBOSE_FETCH:-}" && "${BUN_CONFIG_VERBOSE_FETCH}" != "0" && "${BUN_CONFIG_VERBOSE_FETCH}" != "false" ]]; then
    bun "$REPO_ROOT/scripts/dx_run_control.ts" check-env || exit $?
  fi
  exec bun run "$@"
}

# unknown_command <cmd>: exit 2 with a suggestion; never fall through to running <cmd>.
unknown_command() {
  local bad="$1" hint
  hint="$(bun -e '
    const [bad, ...names] = process.argv.slice(1);
    const dist = (a, b) => {
      let prev = Array.from({ length: b.length + 1 }, (_, j) => j);
      for (let i = 1; i <= a.length; i++) {
        const cur = [i];
        for (let j = 1; j <= b.length; j++)
          cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
        prev = cur;
      }
      return prev[b.length];
    };
    const best = names.map((n) => [n, dist(bad, n)]).sort((x, y) => x[1] - y[1])[0];
    if (best && best[1] <= 2) console.log(best[0]);
  ' "$bad" $DX_COMMANDS 2>/dev/null || true)"
  echo "dx: unknown command '$bad'" >&2
  if [[ -n "$hint" ]]; then
    echo "    did you mean: ./bin/dx $hint" >&2
  fi
  echo "    ./bin/dx help lists the commands; ./bin/dx exec <program> [args] runs any program." >&2
  exit 2
}

cmd="${1:-status}"
shift || true

# --- graph feed poller helpers -------------------------------------------------
# `dx poll --help` must never poll: probing a CLI with --help is a normal agent move,
# and the poller writes docs/graph-live-feed.json (in FIXTURE mode when --live is absent).
dx_wants_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in -h|--help) return 0 ;; esac
  done
  return 1
}

dx_poller_usage() {
  cat <<'USAGE'
dx poll / dx watch — graph feed poller (Polymarket positions + F402 pending)

Usage:
  dx poll [--once] [--live] [--live-f402] [--no-backtest-artifact] [--r2]
  dx watch [--live] [--live-f402] [--no-backtest-artifact]   # --cron loop, 60s cadence
  dx poll --help                                             # prints this; never polls

Modes:
  --once                 one poll cycle, then exit (default when --cron/--r2 are absent)
  --cron                 in-process 60s loop
  --r2                   publish docs/graph-live-feed.json + graph.html to the R2 edge
  --live                 live Polymarket ingest   (same as SPORTSDESK_LIVE_INGEST=1)
  --live-f402            live F402 probe          (same as SPORTSDESK_LIVE_F402=1)
  --no-backtest-artifact do not rewrite the committed 4-week backtest artifact

Fixture trap:
  Without --live the poller writes dataMode FIXTURE — placeholder rows, not desk data —
  and overwrites docs/graph-live-feed.json. A live refresh is:
    SPORTSDESK_LIVE_INGEST=1 ./bin/dx poll --once --no-backtest-artifact
USAGE
}

dx_poller_warn_fixture() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == "--live" ]] && return 0
  done
  [[ "${SPORTSDESK_LIVE_INGEST:-}" == "1" ]] && return 0
  printf '%s\n' \
    "[dx] WARNING: graph poller running WITHOUT --live — it will write dataMode FIXTURE (placeholder rows) over docs/graph-live-feed.json." \
    "[dx]          Live refresh: SPORTSDESK_LIVE_INGEST=1 ./bin/dx poll --once --no-backtest-artifact" >&2
}

case "$cmd" in
  help|--help|-h)
    if (($# > 0)); then
      cd "$REPO_ROOT"
      exec bun "$REPO_ROOT/scripts/dx_run_control.ts" help "$@"
    fi
    cat <<'EOF'
SportsDesk DX — operator commands (Bun 1.4.4)

Usage: ./bin/dx <command> [args...]

  Environment / Diagnostics / Runtime Control
    ./bin/dx status                 Measured environment: git, R2/Pages credentials, edge probe
                                    (DX_STATUS_OFFLINE=1 skips the network probe)
    ./bin/dx setup [--replace]      Report home links (~/.zshrc etc.); --replace backs up and links
    ./bin/dx scripts [filter|--bins|--workspaces]
                                    Group package.json scripts by prefix, list bun x bins, or list workspace scripts
    ./bin/dx workspaces [list|graph|audit|run|add|remove|link|init]
                                    Monorepo workspace dev control (workspace:*, waves, self-contained audit)
    ./bin/dx bun [--url <u>]        Runtime surface, declaration drift, proxy routing
    ./bin/dx provenance [flags]     Bun oracle pin + spine repo & worktree SHA provenance (--table|--json|--yaml)
    ./bin/dx run [flags] <target>   Controlled Bun runner (connects live `bun run --help` + presets)
    ./bin/dx monitor [flags]        Monitor Bun processes, daemon /health + /api/v2/live-bets, profiles
    ./bin/dx live-bets [flags]      Control & monitor v2 live-bets (--source/--fallback/--daemon/--watch)
    ./bin/dx deps [add|remove|version|check]
                                    bun-deps (frozen-safe); version = pm version + lock refresh
    ./bin/dx nsh [doctor|artifacts|verify-loop|check|build|test|run|...]
                                    Native Shell (packages/nsh-desk) CLI & verification loop
    ./bin/dx worktrees [--apply] [--remote] [--ensure-auto-delete] [--offline] [--json|--yaml]
                                    Audit & clean stale Git worktrees and merged local/remote branches

  Manager Tools / partner config (GSID cookie auth — set GSLIVE_SESSION_ID in .env)
    ./bin/dx fetch-config           Fetch partnerConfig JSON → partnerConfig.json
    ./bin/dx fetch-i18n             Fetch i18n translation resources → i18n-resources.json
    ./bin/dx fetch-common           Fetch manager-tools common data → manager-common.json
    ./bin/dx fetch-live-data        Fetch live sports/reference data → live-data.json
    ./bin/dx fetch-report-status    Probe live Manager report endpoints → status matrix
    ./bin/dx fetch-report-periods   Fetch report period vocabulary → report-periods.json

  Wagers by state, day, event, player, agent (columns, groups, layout from config/wagers.json)
    ./bin/dx wagers-by-state --from=M/D/YYYY --to=M/D/YYYY [--state=X] [--nlegs=N] [--wager-number N] [--format=table|json|csv|summary|inspect|columns|grid] [--out=PATH] [--group-by=state|day|event|player|agent] [--top=N]
    ./bin/dx wagers-by-state-live   Same against live ajax.php (requires GSLIVE_SESSION_ID; --format/--out/--group-by/--top supported)

  Ticket lookup
    ./bin/dx ticket <wagerNumber>|--list   One ticket or every ticket's leg count [--file=PATH] [--json]

  Anomaly signatures
    ./bin/dx flags --file=<capture> [--verbose] [--rule=NAME] [--strict] [--json]
    ./bin/dx flags --rules          Deterministic rule catalog
    ./bin/dx flags --review          Plan a stratified review ledger (--budget-minutes, --seed)
    ./bin/dx flags --record          Record one review (--run-id --seq --verdict --reviewer)
    ./bin/dx flags --review-report   Sampled rule precision for a review run
    ./bin/dx flags --review-status   Reviewed vs remaining for a run
    ./bin/dx flags --review-export --format=csv   Reviewer tracker
    ./bin/dx bet-flags <cmd>        Incoming-bet YAML rules, scan, explain, locate & alert ledger
    ./bin/dx layoff-risk <cmd>      Cross-market parlay & layoff risk scanner (scan|seed|daemon)
    ./bin/dx queue [--limit N]      Ranked triage queue (flags, findings, model score, rule evidence, bets)
    ./bin/dx queue build --dry-run  Readiness gate: prints blockers and exits 1; no queue rows

  Surveillance / ingestion
    ./bin/dx modes [1..10]          10-mode forensic / risk / cross-market matrix
    ./bin/dx iptracker              Per-office and cross-office IP clusters
    ./bin/dx gslive <LOGIN>         GSLive 7-param report + live bet-history links
    ./bin/dx poll [--once] [--live] [--live-f402]
                                    Poll feeds (--live = Polymarket, --live-f402 = F402 probe)
    ./bin/dx watch                  In-process Bun.cron daemon (60s) + R2 sync
    ./bin/dx backtest               4-week CFB + NBA parlay/combo backtest

  Utilities
    ./bin/dx docs [gslive|--json]   Deployed API docs (Scalar, R2, local artifacts)
    ./bin/dx stale -i <export>      Stale-line / post-move bet cohort
    ./bin/dx profile <0x|user>      Polymarket PnL, win rate, positions, categories
    ./bin/dx combo legs|price|wallet|uniqueness|verify-subset|backtest
                                    CFB combo legs, pricing, wallet positions, uniqueness, realized PnL
    ./bin/dx bridge coverage|value|match
                                    Cross-domain customer book ↔ Polymarket wallet join
    ./bin/dx pipeline               Docs/artifact verification gates (apply:captures … verify:docs)
    ./bin/dx exec <program> [args]  Run any program with dx's environment (PATH programs also run directly)
    ./bin/dx exec --with <group|NAME> [--] <program> [args]
                                    ...and inject keychain-backed credentials (groups: r2 pages blob gslive daemon telegram)
    ./bin/dx shot <url>             Bun.WebView screenshot → scratch/shots/ (--f402-login, --profile <dir>)
    ./bin/dx session [status|login] Portal session file the replay transport reads (status is read-only)
    ./bin/dx image-meta <file>      Print image metadata via Bun.Image (or '-' for stdin)
    ./bin/dx assets [--write] [--json|--yaml]
                                    Audit & optimize repo image assets with Bun.file().image() & WebP siblings
    ./bin/dx blob-formdata <file>   Parse a blob as FormData and print JSON (or '-' for stdin)
    ./bin/dx xml-parse <file>       Parse XML via Bun.XML as JSON or round-trip XML (or '-' for stdin)
    ./bin/dx sql [--url <u>] <sql>  Read-only SQL inspector via Bun.SQL / Bun.sql (--tables, --json, --yaml)
    ./bin/dx enrich --figure=<path> [--ticker=<path>] [--output=<path>] [--format=inspect|jsonl|summary] [--inspect]
                                    Stream and join live ticker wagers with settled getWagersByFigureDate
    ./bin/dx taxonomy [--mode=CP|CPS|CPV|G] [--period=-1..6] [--engine=native|full] [--sqlite=<path>] [--format=inspect|table|json] [--inspect]
                                    Normalize wagers to canonical 0-6 portal period enum with multi-family dates
    ./bin/dx edge [--input=<path>] [--sort=leak|hold|edge|volume] [--min-wagers=N] [--inspect]
                                    Market edge & leakage dashboard slicing by sport, period & market
    ./bin/dx shadow-price [--db=<path>] [--ladder-3=odds] [--ladder-7=odds] [--min-volume=N] [--elasticity=0.15]
                                    Simulate counterfactual point-buy pricing ladders against settled history

  Deploy
    ./bin/dx stage                  Regenerate + stage dist/ (no upload)
    ./bin/dx deploy                 Stage, publish to R2 and Cloudflare Pages
    ./bin/dx ship                   Deploy, then push main

Docs: README.md · docs/OPERATOR_QUICKSTART_AND_10_MODE_RUNBOOK.md
EOF
    echo ""
    bun "$REPO_ROOT/scripts/dx_run_control.ts" help --connected-footer
    ;;
  status)
    # Every line below is measured now, or says what it could not measure. Nothing is hardcoded OK.
    # Slow subprocess / network probes run concurrently into a private scratch dir and join via `wait`.
    dx_ok() { echo "✅ $1"; }
    dx_warn() { echo "⚠️  $1"; }
    dx_bad() { echo "❌ $1"; }
    dx_portal="https://pub-d061f943df0e4477ba7ff200721eddb1.r2.dev/graph.html"
    dx_probe_dir="$(mktemp -d "${TMPDIR:-/tmp}/dx-status.XXXXXX")"
    (
      if out="$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null)"; then
        if [[ -z "$out" ]]; then
          printf '0|0\n' >"$dx_probe_dir/git"
        else
          printf '0|%s\n' "$(printf '%s\n' "$out" | wc -l | tr -d ' ')" >"$dx_probe_dir/git"
        fi
      else
        printf '1|0\n' >"$dx_probe_dir/git"
      fi
    ) &
    (
      if [[ "${DX_STATUS_OFFLINE:-}" == "1" ]]; then
        printf '%s\n' "not probed (DX_STATUS_OFFLINE=1)" >"$dx_probe_dir/wrangler"
      else
        (cd "$REPO_ROOT" && "$REPO_ROOT/bin/wrangler" --version 2>/dev/null | grep -m1 -v '^[[:space:]]*$' || true) >"$dx_probe_dir/wrangler"
      fi
    ) &
    (
      if (cd "$REPO_ROOT" && bun scripts/publish_r2_graph.mjs --check-credentials >/dev/null 2>&1); then
        printf 'ok\n' >"$dx_probe_dir/r2"
      else
        printf 'missing\n' >"$dx_probe_dir/r2"
      fi
    ) &
    (
      if [[ "${DX_STATUS_OFFLINE:-}" != "1" ]]; then
        (curl -sS -o /dev/null -I -m 3 -w '%{http_code}' "$dx_portal" 2>/dev/null || true) >"$dx_probe_dir/portal"
      fi
    ) &
    dx_bun_ver="$(bun -v 2>/dev/null || echo 'bun missing')"
    dx_git_tip="$(git -C "$REPO_ROOT" log -n 1 --oneline 2>/dev/null || echo 'unknown')"
    dx_staged_dist="$(ls -1 "$REPO_ROOT/dist" 2>/dev/null | tr '\n' ' ' || true)"
    wait || true
    IFS='|' read -r dx_git_rc dx_dirty_count <"$dx_probe_dir/git" || { dx_git_rc="1"; dx_dirty_count="0"; }
    dx_wrangler="$(cat "$dx_probe_dir/wrangler" 2>/dev/null || true)"
    dx_r2_state="$(cat "$dx_probe_dir/r2" 2>/dev/null || true)"
    dx_code="$(cat "$dx_probe_dir/portal" 2>/dev/null || true)"
    rm -rf "$dx_probe_dir"

    echo "================================================================================"
    echo "  🛠️  SPORTSDESK & DOTFILES DX STATUS (measured $(date '+%Y-%m-%d %H:%M:%S %Z'))"
    echo "================================================================================"
    echo "  • \$HOME                : $HOME"
    if [[ -n "$ORIG_XDG_CONFIG_HOME" && "$ORIG_XDG_CONFIG_HOME" != "$XDG_CONFIG_HOME" ]]; then
      echo "  • XDG_CONFIG_HOME      : $XDG_CONFIG_HOME (re-anchored from $ORIG_XDG_CONFIG_HOME)"
    else
      echo "  • XDG_CONFIG_HOME      : $XDG_CONFIG_HOME (unchanged)"
    fi
    if [[ -d "${DOTFILES_ROOT:-}" ]]; then
      echo "  • DOTFILES_ROOT        : $DOTFILES_ROOT ($(dx_ok connected))"
    else
      echo "  • DOTFILES_ROOT        : ${DOTFILES_DIR} ($(dx_bad 'not found; set DX_DOTFILES_DIR'))"
    fi
    if [[ "$dx_git_rc" == "0" ]]; then
      echo "  • git status           : $HOME/.gitconfig ($(dx_ok 'git status exits 0'))"
      if [[ "${dx_dirty_count:-0}" == "0" ]]; then
        echo "  • Worktree cleanliness : $(dx_ok 'clean (0 uncommitted paths)')"
      else
        echo "  • Worktree cleanliness : $(dx_warn "${dx_dirty_count} uncommitted path(s) (git status --porcelain)")"
      fi
    else
      echo "  • git status           : $HOME/.gitconfig ($(dx_warn 'git status exits non-zero'))"
    fi
    if ((${#DX_LINK_CONFLICTS[@]})); then
      echo "  • Home links           : $(dx_warn "${#DX_LINK_CONFLICTS[@]} real file(s) left in place, not linked")"
      for dx_path in "${DX_LINK_CONFLICTS[@]}"; do echo "      - $dx_path   (./bin/dx setup --replace backs it up and links)"; done
    else
      echo "  • Home links           : $(dx_ok 'no conflicts')"
    fi
    echo "  • Bun / Wrangler       : ${dx_bun_ver} / ${dx_wrangler:-wrangler missing}"
    echo "  • Git Branch & Tip     : ${dx_git_tip}"
    echo "  • Staged dist/ Assets  : ${dx_staged_dist}"
    if [[ "$dx_r2_state" == "ok" ]]; then
      echo "  • R2 S3 credentials    : $(dx_ok 'present (deploy signs with SigV4)')"
    else
      echo "  • R2 S3 credentials    : $(dx_warn 'missing; deploy falls back to Wrangler OAuth, without x-amz-meta-*')"
    fi
    if [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]]; then
      echo "  • Pages token          : $(dx_ok 'CLOUDFLARE_API_TOKEN set')"
    else
      echo "  • Pages token          : $(dx_warn 'CLOUDFLARE_API_TOKEN unset; deploy skips the Pages step')"
    fi
    if [[ "${DX_STATUS_OFFLINE:-}" == "1" ]]; then
      echo "  • R2 Edge Portal       : $dx_portal (not probed: DX_STATUS_OFFLINE=1)"
    else
      if [[ "$dx_code" == "200" ]]; then
        echo "  • R2 Edge Portal       : $dx_portal ($(dx_ok 'HTTP 200 (HEAD, 3s timeout)'))"
      else
        echo "  • R2 Edge Portal       : $dx_portal ($(dx_warn "HEAD returned '${dx_code:-no response}' within 3s"))"
      fi
    fi
    echo "  • Screenshot Output    : $REPO_ROOT/scratch/shots (Bun.WebView; dx shot <url>)"
    echo "================================================================================"
    ;;
  setup)
    # The home links were already (re)applied by the preamble; this reports what happened.
    echo "dx setup: dotfiles $DOTFILES_DIR"
    if ((${#DX_LINK_CONFLICTS[@]})); then
      echo "These real files were left in place (nothing is overwritten automatically):"
      for dx_path in "${DX_LINK_CONFLICTS[@]}"; do echo "  - $dx_path"; done
      echo "Run ./bin/dx setup --replace to move each to <path>.dx-backup-<epoch> and link it."
    else
      echo "Home links are in place; no conflicts."
    fi
    ;;
  scripts)
    cd "$REPO_ROOT"
    dx_bun_run scripts/dx_scripts.ts "$@"
    ;;
  run)
    cd "$REPO_ROOT"
    exec bun "$REPO_ROOT/scripts/dx_run_control.ts" run "$@"
    ;;
  monitor)
    cd "$REPO_ROOT"
    exec bun "$REPO_ROOT/scripts/dx_run_control.ts" monitor "$@"
    ;;
  live-bets)
    cd "$REPO_ROOT"
    exec bun "$REPO_ROOT/scripts/dx_run_control.ts" live-bets "$@"
    ;;
  iptracker)
    cd "$REPO_ROOT"
    dx_bun_run scripts/dx_iptracker.ts "$@"
    ;;
  modes)
    cd "$REPO_ROOT"
    dx_bun_run scripts/dx_modes.ts "$@"
    ;;
  gslive)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_cli.ts gslive "$@"
    ;;
  docs|api-docs|api)
    cd "$REPO_ROOT"
    dx_bun_run scripts/api_docs_cli.ts "$@"
    ;;
  stale)
    cd "$REPO_ROOT"
    dx_bun_run scripts/stale_line_cohort_cli.ts "$@"
    ;;
  profile)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_cli.ts profile "$@"
    ;;
  combo)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_cli.ts combo "$@"
    ;;
  bridge|crossdomain)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_cli.ts bridge "$@"
    ;;
  shot|screenshot)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_cli.ts shot "$@"
    ;;
  session)
    cd "$REPO_ROOT"
    sub="${1:-status}"
    shift || true
    case "$sub" in
      status) exec bun run scripts/session_login.ts --status "$@" ;;
      login) exec bun run scripts/session_login.ts "$@" ;;
      *)
        echo "usage: ./bin/dx session [status [--json] | login]" >&2
        exit 2
        ;;
    esac
    ;;
  image-meta)
    cd "$REPO_ROOT"
    exec bun bin/image-meta.ts "$@"
    ;;
  assets)
    cd "$REPO_ROOT"
    exec bun run scripts/optimize_assets.ts "$@"
    ;;
  bun)
    cd "$REPO_ROOT"
    exec bun bin/bun_surface.ts "$@"
    ;;
  provenance)
    cd "$REPO_ROOT"
    exec bun bin/desk-provenance.ts "$@"
    ;;
  deps)
    # Deliberately no `cd "$REPO_ROOT"`: bun-deps acts on the directory you are
    # standing in, so `dx deps add` inside a workspace edits that package's
    # package.json and the root bun.lock. `check` is the machine policy doctor.
    case "${1:-}" in
      check)
        shift
        exec bun "$REPO_ROOT/scripts/pm_doctor.ts" "$@"
        ;;
      version)
        # `bun pm version` does not touch bun.lock, and a frozen install still
        # passes with the lock behind — the documented trap. Bump, refresh the
        # lock, then verify only the lock-shaped checks.
        shift
        case "${1:-}" in
          --help|-h|"")
            cat <<'VERSION_HELP'
dx deps version <newversion> [--no-git-tag-version]

  Runs `bun pm version` in the current package, then `bun-deps install` to
  bring bun.lock back in step, then `pm:doctor --only lock,patches`.

  A frozen install passes even when the lock is behind, so the refresh is the
  point of this wrapper. Run it inside the workspace whose version changes.
VERSION_HELP
            exit 0
            ;;
        esac
        bun pm version "$@"
        bun-deps install
        exec bun "$REPO_ROOT/scripts/pm_doctor.ts" --only "lock workspaces,lock versions,patches"
        ;;
      --help|-h|"")
        exec bun-deps --help
        ;;
      *)
        exec bun-deps "$@"
        ;;
    esac
    ;;
  blob-formdata)
    cd "$REPO_ROOT"
    exec bun bin/blob-formdata.ts "$@"
    ;;
  xml-parse)
    cd "$REPO_ROOT"
    exec bun bin/xml-parse.ts "$@"
    ;;
  sql)
    cd "$REPO_ROOT"
    exec bun bin/sql-query.ts "$@"
    ;;
  fetch-config)
    cd "$REPO_ROOT"
    dx_bun_run scripts/fetch-config.ts "$@"
    ;;
  fetch-i18n)
    cd "$REPO_ROOT"
    dx_bun_run scripts/fetch-i18n.ts "$@"
    ;;
  fetch-common)
    cd "$REPO_ROOT"
    dx_bun_run scripts/fetch-common.ts "$@"
    ;;
  fetch-live-data)
    cd "$REPO_ROOT"
    dx_bun_run scripts/fetch-live-data.ts "$@"
    ;;
  fetch-report-status)
    cd "$REPO_ROOT"
    dx_bun_run scripts/fetch-report-status.ts "$@"
    ;;
  fetch-report-periods)
    cd "$REPO_ROOT"
    dx_bun_run scripts/fetch-report-periods.ts "$@"
    ;;
  wagers-by-state)
    cd "$REPO_ROOT"
    dx_bun_run scripts/wagers_by_state_last14.ts -- "$@"
    ;;
  wagers-by-state-live)
    cd "$REPO_ROOT"
    dx_bun_run scripts/wagers_by_state_live.ts -- "$@"
    ;;
  ticket)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_ticket_cli.ts "$@"
    ;;
  flags)
    cd "$REPO_ROOT"
    dx_bun_run cli/flags.ts "$@"
    ;;
  bet-flags)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_bet_flags_cli.ts "$@"
    ;;
  layoff-risk)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_layoff_risk_cli.ts "$@"
    ;;
  queue)
    cd "$REPO_ROOT"
    dx_bun_run cli/sportsdesk_fraud_cli.ts queue "$@"
    ;;
  backtest)
    cd "$REPO_ROOT"
    dx_bun_run scripts/run_4wk_parlay_combo_backtest.ts "$@"
    ;;
  poll)
    if dx_wants_help "$@"; then
      dx_poller_usage
      exit 0
    fi
    dx_poller_warn_fixture "$@"
    cd "$REPO_ROOT"
    dx_bun_run scripts/graph_feed_poller_daemon.ts "$@"
    ;;
  watch)
    if dx_wants_help "$@"; then
      dx_poller_usage
      exit 0
    fi
    dx_poller_warn_fixture "$@"
    cd "$REPO_ROOT"
    exec bun --no-orphans --watch run scripts/graph_feed_poller_daemon.ts --cron "$@"
    ;;
  pipeline)
    cd "$REPO_ROOT"
    bun run apply:captures --dry-run
    bun run artifacts:lock
    bun run audit:ops
    bun run docs:render
    bun run tasks:render --no-color --columns 0 >/dev/null
    bun run verify:docs
    echo "✓ Pipeline verification gates passed (apply:captures, artifacts:lock, audit:ops, docs:render, tasks:render, verify:docs)"
    ;;
  stage)
    cd "$REPO_ROOT"
    # Feed-only refresh: the historical backtest artifact is a separate, deliberate build.
    "$0" poll --once --no-backtest-artifact
    bun run scripts/generate_pipeline_reference_images.ts
    # Staging itself is package.json `docs:stage` — one list, so this cannot drift again.
    bun run docs:stage
    echo "✓ Staged dist/ via docs:stage (index.html, graph.html, graph.js, assets/gslive-links.js, assets/live-ops.js, graph-live-feed.json, backtest-4wk-cfb-nba.json, combo-uniqueness.json, cross-domain-bridge.json, openapi.json, api-reference.md, pipeline assets, _headers)"
    shasum -a 256 dist/index.html dist/graph.html dist/graph.js dist/graph-live-feed.json dist/backtest-4wk-cfb-nba.json dist/combo-uniqueness.json dist/cross-domain-bridge.json dist/openapi.json dist/api-reference.md dist/assets/gslive-links.js dist/assets/live-ops.js dist/assets/pipeline-artifacts-metadata.json dist/_headers
    ;;
  deploy)
    "$0" stage
    cd "$REPO_ROOT"
    if bun scripts/publish_r2_graph.mjs --check-credentials >/dev/null 2>&1; then
      bun run scripts/publish_r2_graph.mjs
    else
      echo "⚠️  R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY unset — uploading via Wrangler OAuth."
      echo "    x-amz-meta-* object metadata is omitted in this mode (set the S3 keys for full metadata)."
      manifest=$(mktemp)
      bun scripts/publish_r2_graph.mjs --list-json > "$manifest"
      bucket=$(bun -e 'const m=JSON.parse(await Bun.file(process.argv[1]).text()); console.log(m.bucket);' "$manifest")
      while IFS=$'\t' read -r key file type; do
        if [[ ! -f "$file" ]]; then
          echo "  skip missing $file"
          continue
        fi
        echo "  ↑ $bucket/$key"
        "$REPO_ROOT/bin/wrangler" r2 object put "$bucket/$key" --file="$file" --content-type="$type" --remote || exit 1
      done < <(bun -e 'const m=JSON.parse(await Bun.file(process.argv[1]).text()); for (const f of m.files) console.log([f.key,f.file,f.type].join("\t"));' "$manifest")
      rm -f "$manifest"
    fi
    if [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]]; then
      "$REPO_ROOT/bin/wrangler" pages deploy dist --project-name=fantasy402-docs --branch=main "$@"
    else
      echo "⚠️  Cloudflare Pages deploy SKIPPED: CLOUDFLARE_API_TOKEN is unset (R2 upload above is done)." >&2
      echo "    Put a Pages-scoped CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in ./cloudflare.env or" >&2
      echo "    \$XDG_CONFIG_HOME/cloudflare/pages.env (never .env), then re-run ./bin/dx deploy." >&2
    fi
    ;;
  ship)
    "$0" deploy "$@"
    cd "$REPO_ROOT"
    if ! git push origin main; then
      echo "❌ ship: deploy finished but 'git push origin main' FAILED; the remote main is not updated." >&2
      echo "   Run 'git push origin main' from a shell that can reach the remote, then re-check." >&2
      exit 1
    fi
    ;;
  exec)
    # `dx exec --with <group|NAME>[,…] [--] prog args` hands keychain-backed credentials to that
    # one program (environment first, keychain second). Without --with it is the plain passthrough.
    case "${1:-}" in
      --with | --with=*) exec bun "$REPO_ROOT/scripts/secrets_env.ts" exec "$@" ;;
    esac
    exec "$@"
    ;;
  enrich)
    cd "$REPO_ROOT"
    dx_bun_run "$REPO_ROOT/scripts/enrich_bets_from_figure_date.ts" "$@"
    ;;
  taxonomy)
    cd "$REPO_ROOT"
    dx_bun_run "$REPO_ROOT/scripts/normalize.ts" "$@"
    ;;
  edge)
    cd "$REPO_ROOT"
    dx_bun_run "$REPO_ROOT/scripts/market_edge_dashboard.ts" "$@"
    ;;
  shadow-price)
    cd "$REPO_ROOT"
    dx_bun_run "$REPO_ROOT/scripts/shadow_price.ts" "$@"
    ;;
  nsh)
    cd "$REPO_ROOT"
    exec bun run scripts/nsh_desk_cli.ts "$@"
    ;;
  worktrees)
    exec bun run "$REPO_ROOT/scripts/dx_worktrees.ts" "$@"
    ;;
  workspaces)
    cd "$REPO_ROOT"
    exec bun "$REPO_ROOT/scripts/dx_workspaces.ts" "$@"
    ;;
  *)
    # A real program on PATH still runs (`dx wrangler ...`, `dx git ...`). A typo no longer dies
    # with "exec: stauts: not found" (exit 127): it gets a suggestion and exit 2.
    if command -v "$cmd" >/dev/null 2>&1; then
      exec "$cmd" "$@"
    fi
    unknown_command "$cmd"
    ;;
esac
