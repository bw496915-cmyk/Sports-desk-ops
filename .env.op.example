# 1Password `op run --env-file=.env.op` template for unattended macOS LaunchAgents
# (`com.bookdeskops.sportsdesk.daemon` and `com.bookdeskops.sportsdesk.session-refresh`).
#
# Setup:
#   1. Copy this file to `.env.op` (`chmod 600 .env.op` — `.env.op` is gitignored).
#   2. Replace placeholder `op://SportsDesk/<Item>/<Field>` references using `op item list --vault SportsDesk`.
#   3. Provision a 1Password Service Account token (`OP_SERVICE_ACCOUNT_TOKEN`) when running
#      `scripts/install_session_refresh_agent.sh install --target both`.
#
# Notes:
#   - `HOST`, `PORT`, and `NO_PROXY` belong in the LaunchAgent plist `EnvironmentVariables`
#     (single SSOT — do not duplicate them here).
#   - `GITHUB_TOKEN` is intentionally omitted: `lib/github_token.ts` reads Keychain `github-token`
#     (not `Bun.env`) and `GITHUB_TOKEN` is not in `lib/secret_manifest.ts`.
#   - GSLive (`~/.config/sportsdesk/gslive-session`) is provisioned manually via browser export
#     because Cloudflare blocks unattended GSLive sign-in.

# Policy flag required so `op run`-injected `F402_*` env credentials authenticate unattended refreshes
F402_ALLOW_ENV_CREDENTIALS=1

# F402 (`f402` manifest group)
F402_AGENT_ID=op://SportsDesk/Fantasy402/agent_id
F402_PASSWORD=op://SportsDesk/Fantasy402/password
# Optional bearer JWT for sched_agent_tree_hourly:
# F402_BEARER_TOKEN=op://SportsDesk/Fantasy402/bearer_token

# Daemon & Telegram (`daemon` + `telegram` manifest groups)
SPORTSDESK_ADMIN_TOKEN=op://SportsDesk/SportsDesk Daemon/admin_token
TELEGRAM_BOT_TOKEN=op://SportsDesk/Telegram/bot_token
TELEGRAM_CHAT_ID=op://SportsDesk/Telegram/chat_id
# Optional webhook secret:
# TELEGRAM_WEBHOOK_SECRET=op://SportsDesk/Telegram/webhook_secret

# Cloudflare R2 & Blob (`r2` + `blob` manifest groups)
CLOUDFLARE_ACCOUNT_ID=op://SportsDesk/Cloudflare R2/account_id
R2_ACCESS_KEY_ID=op://SportsDesk/Cloudflare R2/access_key_id
R2_SECRET_ACCESS_KEY=op://SportsDesk/Cloudflare R2/secret_access_key
R2_BUCKET_NAME=sportsdesk-ops-reports
BLOB_API_TOKEN=op://SportsDesk/SportsDesk Blob/api_token
BLOB_TICKET_SECRET=op://SportsDesk/SportsDesk Blob/ticket_secret
