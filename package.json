{
  "name": "sportsdesk-ops",
  "version": "1.0.0",
  "description": "SportsDesk & Fantasy402 Downline Risk Surveillance, Bettor Churn Simulation, and Cloudflare R2 Sync Suite",
  "main": "sportsdesk_cli.ts",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "typecheck": "bun --check",
    "lint": "bun --bun run oxlint --fix",
    "lint:check": "bun --bun run oxlint --deny-warnings",
    "gen:tokens": "bun run scripts/generate_tokens.ts",
    "check:fetch-init": "bun run bin/check-fetch-init.ts",
    "check:innerhtml": "bun run bin/check-innerhtml.ts",
    "cli": "bun run sportsdesk_cli.ts",
    "sim": "bun run simulate_bettor_churn_suite.ts",
    "reports": "./run_reports.sh",
    "reports:r2": "./run_reports.sh --sync-r2",
    "r2:info": "bun run sportsdesk_r2_sync.ts --info",
    "r2:verify": "bun run sportsdesk_r2_sync.ts --verify",
    "r2:sync": "bun run sportsdesk_r2_sync.ts --sync reports/",
    "r2:list": "bun run sportsdesk_r2_sync.ts --list",
    "bot": "bun run sportsdesk_telegram_bot.ts",
    "scheduler": "bun run reporting_scheduler_service.ts",
    "onepass": "bun run agent_onepass_plugin.ts",
    "serve": "bun run sportsdesk_webview_server.ts",
    "deploy": "./deploy_to_vps.sh"
  },
  "keywords": [
    "sportsdesk",
    "fantasy402",
    "risk-surveillance",
    "churn-prediction",
    "cloudflare-r2",
    "telegram-bot",
    "bun"
  ],
  "author": "bw496915-cmyk",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxlint": "1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bw496915-cmyk/Sports-desk-ops.git"
  },
  "bugs": {
    "url": "https://github.com/bw496915-cmyk/Sports-desk-ops/issues"
  },
  "homepage": "https://github.com/bw496915-cmyk/Sports-desk-ops#readme",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  }
}
