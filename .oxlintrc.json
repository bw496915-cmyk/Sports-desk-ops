{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "eqeqeq": ["error", "smart"],
    "typescript/no-explicit-any": "error",
    "typescript/no-require-imports": "error",
    "preserve-caught-error": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "verification/manager-boot-oracle/pinned/**",
    "scratch/**",
    "Scratch/**",
    "dist/**"
  ]
}
