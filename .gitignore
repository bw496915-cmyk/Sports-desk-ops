!tests/fixtures/backtest/enriched_customers_full.json
!tests/fixtures/backtest/sportsdesk_downline_data.json

# Generated by `bun pm licenses --prod --json` for image/licence auditing; not an input.
# Regenerate with: bun pm licenses --prod --json | sed "s|$HOME|<home>|g" > licenses.json
/licenses.json

# test run output (agent-graph build/webp fixtures)
lib/.tmp-artifacts/
# CI test step reporter output (bun run ci:local)
junit-report.xml
.bun-test-timings.json

# Large report exports (contain identifiers; never commit)
betReport*.json

# Agent worktrees and scratch: DSH agents create these under .agents/.
/.agents/
# Git worktrees checked out beside the main checkout.
.worktrees/

# Wire captures can carry auth headers or session cookies; never commit them.
*.har

# Untracked operator download (31 KB junk; see AGENTS.md "do not commit").
gs-manager-cli.zip
# Local macOS Notes export that has appeared at the root before.
Untitled.txt.rtf

# Bun/tooling temp dirs under lib/ (tests and the agent-graph build).
lib/.tmp-*/

