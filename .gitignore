*.dodbin
# Runtime capture-health snapshot (regenerated by capture:all)
data/capture-health.json
# The synthetic fixture reuses those names because the engine joins fixed paths; it carries no
# real customer data and must stay tracked or the CI test silently degrades to the snapshot.
!tests/fixtures/backtest/enriched_customers_full.json
!tests/fixtures/backtest/sportsdesk_downline_data.json
!tests/fixtures/verify-load/enriched_customers_full.json
!tests/fixtures/verify-load/sportsdesk_downline_data.json
!tests/fixtures/verify-load/dist/
!tests/fixtures/verify-load/dist/**
tests/fixtures/verify-load/.materialized/

# Generated by `bun pm licenses --prod --json` for image/licence auditing; not an input.
# Regenerate with: bun pm licenses --prod --json | sed "s|$HOME|<home>|g" > licenses.json
/licenses.json

# test run output (agent-graph build/webp fixtures)
lib/.tmp-artifacts/
# CI test step reporter output (bun run ci:local)
junit-report.xml
.bun-test-timings.json

# Large report exports (contain identifiers; never commit)
betReport*.json

# Append-only audit logs (contain operator activity, IPs, and identifiers; local only)
/audit/
audit/

# Agent worktrees and scratch: DSH agents create these under .agents/.
/.agents/*
!/.agents/skills/
!/.agents/skills/**
# Git worktrees checked out beside the main checkout.
.worktrees/

# Wire captures can carry auth headers or session cookies; never commit them.
*.har

# Untracked operator download (31 KB junk; see AGENTS.md "do not commit").
gs-manager-cli.zip
# Local macOS Notes export that has appeared at the root before.
Untitled.txt.rtf

# Bun/tooling temp dirs under lib/ (tests and the agent-graph build).
lib/.tmp-*/

# Bun test env files. `.env.example` is tracked and intentionally not matched.
.env.test
.env.test.*

# Cloudflare Pages credentials read by bin/dx (`cloudflare.env` in the repo root or the workspace).
/cloudflare.env
cloudflare.env

# Native Shell (nsh) generated types, bundles, and package outputs.
**/.nsh/*
!packages/nsh-desk/.nsh/tsconfig.json
pages.env
